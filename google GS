/**
 * 崇正國樂團智能系統 - GAS 後端終極整合版
 * 修正項目：對齊所有 Action 名稱，補齊 getEventList 與 getSurveyList 函數，優化時數計算與問卷統計
 */

const SS = SpreadsheetApp.getActiveSpreadsheet();

// --- API 進入點 ---
function doPost(e) {
  let result;
  try {
    const requestData = JSON.parse(e.postData.contents);
    const action = requestData.action;
    const data = requestData.data;

    // 確保所有必要的工作表都已建立並初始化
    checkAndInitSheets();

    switch (action) {
      // 1. 成員與認證
      case 'loginUser': result = loginUser(data); break;
      case 'registerUser': result = registerUser(data); break;
      case 'saveMember': result = saveMember(data); break;
      
      // 2. 公告系統
      case 'getAnnouncement': result = getAnnouncement(); break;
      case 'saveAnnouncement': result = saveAnnouncement(data); break;
      
      // 3. 活動管理
      case 'getSystemStatus': result = getSystemStatus(data); break;
      case 'submitCheckin': result = submitCheckin(data); break; 
      case 'getAttendanceHistory': result = getAttendanceHistory(data); break;
      case 'getEventList': result = getEventList(); break;
      case 'saveEvent': result = saveEvent(data); break; 
      case 'activateEvent': result = activateEvent(data); break;
      case 'getMemberHistory': result = getMemberHistory(data); break;

      // 4. 即時狀態監控 (組長權限限制邏輯位於前端，後端提供全量資料)
      case 'getRealtimeStatus': result = getRealtimeStatus(data); break; 
      
      // 5. 問卷管理系統
      case 'getSurveyList': result = getSurveyList(); break;
      case 'saveSurveyConfig': result = saveSurveyConfig(data); break; 
      case 'getSurveyStatus': result = getSurveyStatus(data); break; 
      case 'submitSurveyResponse': result = submitSurveyResponse(data); break; 
      case 'getSurveyResults': result = getSurveyResults(data); break; 

      default: result = { success: false, message: "未知指令: " + action };
    }
  } catch (err) {
    result = { success: false, message: "後端程式錯誤: " + err.toString() };
  }
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}

// ==========================================
// A. 活動管理函數 (Event Management)
// ==========================================

function getEventList() {
  try {
    const sheet = SS.getSheetByName("Events");
    const vals = sheet.getDataRange().getValues();
    const list = vals.slice(1).map(r => ({
      ID: r[0], 
      Name: r[1], 
      Type: r[2], 
      Date: r[3] instanceof Date ? Utilities.formatDate(r[3], "GMT+8", "yyyy-MM-dd") : String(r[3]),
      StartTime: formatTimeValue(r[4]), 
      EndTime: formatTimeValue(r[5]), 
      RestStart: formatTimeValue(r[8]), 
      RestEnd: formatTimeValue(r[9])
    }));
    return { success: true, data: list.reverse() };
  } catch (e) {
    return { success: false, message: "獲取活動失敗: " + e.toString() };
  }
}

function saveEvent(data) {
  try {
    const sheet = SS.getSheetByName("Events");
    let totalMin = calculateDiffMinutes(data.startTime, data.endTime);
    // 扣除休息時間
    if (data.restStart && data.restEnd) {
      totalMin = Math.max(0, totalMin - calculateDiffMinutes(data.restStart, data.restEnd));
    }
    const durStr = Math.floor(totalMin / 60) + "時" + (totalMin % 60) + "分";
    const id = data.id || "EVT-" + Date.now();
    
    // [ID, 名稱, 類型, 日期, 開始, 結束, 時長字串, 建立日期, 休息開始, 休息結束]
    const rowData = [id, data.name, data.type || "團練", data.date, data.startTime, data.endTime, durStr, new Date(), data.restStart || "", data.restEnd || ""];
    
    const vals = sheet.getDataRange().getValues();
    let rowIdx = -1;
    for (let i = 1; i < vals.length; i++) {
      if (String(vals[i][0]) === String(id)) { rowIdx = i + 1; break; }
    }

    if (rowIdx !== -1) {
      sheet.getRange(rowIdx, 1, 1, rowData.length).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

function activateEvent(data) {
  try {
    const ev = SS.getSheetByName("Events").getDataRange().getValues().find(r => String(r[0]) === String(data.id));
    if (!ev) return { success: false, message: "找不到該活動資料" };
    
    // 更新 SystemConfig 
    // 欄位：[狀態, 活動名, 類型, 開始, 結束, _, _, 日期, ID, 休始, 休止]
    const configData = [ "on", ev[1], ev[2], ev[4], ev[5], "", "", ev[3], ev[0], ev[8], ev[9] ];
    SS.getSheetByName("SystemConfig").getRange(2, 1, 1, 11).setValues([configData]);
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

// ==========================================
// B. 問卷管理函數 (Survey Management)
// ==========================================

function getSurveyList() {
  try {
    const sheet = SS.getSheetByName("SurveyTemplates");
    if (!sheet) return { success: true, data: [] };
    const vals = sheet.getDataRange().getValues();
    const activeId = SS.getSheetByName("SystemConfig").getRange(2, 12).getValue();
    const list = vals.slice(1).map(r => ({
      ID: r[0], Title: r[1], Description: r[2], QuestionsJSON: r[3], Active: String(r[0]) === String(activeId)
    }));
    return { success: true, data: list.reverse() };
  } catch (e) {
    return { success: false, message: "獲取問卷庫失敗: " + e.toString() };
  }
}

function saveSurveyConfig(data) {
  try {
    const sheet = SS.getSheetByName("SurveyTemplates");
    const id = data.id || "SUR-" + Date.now();
    const rowData = [id, data.title, data.description, data.questionsJSON, new Date()];
    const vals = sheet.getDataRange().getValues();
    let rowIdx = -1;
    for (let i = 1; i < vals.length; i++) {
      if (String(vals[i][0]) === String(id)) { rowIdx = i + 1; break; }
    }

    if (rowIdx !== -1) {
      sheet.getRange(rowIdx, 1, 1, 5).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }
    
    // 如果勾選開放，更新系統目前的問卷 ID
    if (data.active) {
      SS.getSheetByName("SystemConfig").getRange(2, 12).setValue(id);
    }
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

function getSurveyResults(data) {
  try {
    const template = SS.getSheetByName("SurveyTemplates").getDataRange().getValues().find(r => String(r[0]) === String(data.id));
    if (!template) return { success: false, message: "找不到問卷模板" };
    
    const questions = JSON.parse(template[3] || "[]");
    const responses = SS.getSheetByName("SurveyResponses").getDataRange().getValues();
    
    const results = questions.map(q => {
      const stats = {};
      responses.forEach(r => {
        if (String(r[3]) === String(data.id)) {
          try {
            const userResp = JSON.parse(r[4] || "{}");
            const val = userResp[q.label];
            if (val) stats[val] = (stats[val] || 0) + 1;
          } catch(e) {}
        }
      });
      return { label: q.label, stats: stats };
    });
    return { success: true, data: results };
  } catch(e) { 
    return { success: false, message: "統計出錯: " + e.toString() }; 
  }
}

// ==========================================
// C. 監控與統計 (Monitoring)
// ==========================================

function getRealtimeStatus(userData) {
  try {
    const members = SS.getSheetByName("Members").getDataRange().getValues();
    const attendance = SS.getSheetByName("Attendance").getDataRange().getValues();
    const events = SS.getSheetByName("Events").getDataRange().getValues();
    const config = SS.getSheetByName("SystemConfig").getRange(2, 1, 1, 12).getValues()[0];
    
    const isSystemOn = config[0] === "on";
    const currentEventDate = config[7] instanceof Date ? Utilities.formatDate(config[7], "GMT+8", "yyyy-MM-dd") : String(config[7]);
    const currentEventName = config[1];

    // 計算歷史活動次數以統計缺席
    const now = new Date();
    const todayStr = Utilities.formatDate(now, "GMT+8", "yyyy-MM-dd");
    let pastEventsCount = 0;
    for (let k = 1; k < events.length; k++) {
      let ed = events[k][3];
      if (ed instanceof Date) ed = Utilities.formatDate(ed, "GMT+8", "yyyy-MM-dd");
      if (String(ed) <= todayStr) pastEventsCount++;
    }

    const userStats = {};
    for (let i = 1; i < attendance.length; i++) {
      const email = String(attendance[i][3]).trim().toLowerCase();
      let attDate = attendance[i][5]; 
      if (attDate instanceof Date) attDate = Utilities.formatDate(attDate, "GMT+8", "yyyy-MM-dd");
      
      if (!userStats[email]) userStats[email] = { count: 0, today: false };
      userStats[email].count++;
      
      if (isSystemOn && attDate === currentEventDate && String(attendance[i][4]) === currentEventName) {
        userStats[email].today = true;
      }
    }

    const resultData = members.slice(1).map(m => {
      const email = String(m[3]).trim().toLowerCase();
      const stats = userStats[email] || { count: 0, today: false };
      return {
        Name: m[1], Email: email, Section: m[2], Instrument: m[6], Role: m[5],
        status: stats.today ? "已簽到" : "未簽到",
        absenceCount: Math.max(0, pastEventsCount - stats.count)
      };
    });

    return { 
      success: true, 
      data: resultData, 
      stats: { present: resultData.filter(r=>r.status==="已簽到").length, absent: resultData.filter(r=>r.status==="未簽到").length } 
    };
  } catch (err) { 
    return { success: false, message: "即時監控載入錯誤: " + err.toString() }; 
  }
}

// ==========================================
// D. 基礎功能 (認證、歷史紀錄、公告)
// ==========================================

function loginUser(data) {
  const vals = SS.getSheetByName("Members").getDataRange().getValues();
  const e = String(data.email).trim().toLowerCase();
  const p = String(data.password).trim();
  for (let i = 1; i < vals.length; i++) {
    if (String(vals[i][3]).trim().toLowerCase() === e && String(vals[i][4]) === p) {
      return { 
        success: true, 
        user: { Name: vals[i][1], Section: vals[i][2], Email: vals[i][3], Role: vals[i][5], Instrument: vals[i][6] } 
      };
    }
  }
  return { success: false, message: "帳號或密碼錯誤" };
}

function registerUser(data) {
  const sheet = SS.getSheetByName("Members");
  const email = String(data.email).trim().toLowerCase();
  const vals = sheet.getDataRange().getValues();
  if (vals.some(r => String(r[3]).trim().toLowerCase() === email)) return { success: false, message: "此帳號已註冊過" };
  
  sheet.appendRow(["MEM-" + Date.now(), data.name.trim(), data.section, email, String(data.password).trim(), "Member", data.instrument, new Date(), "系統註冊"]);
  return { success: true };
}

function submitCheckin(data) {
  try {
    const config = SS.getSheetByName("SystemConfig").getRange(2, 1, 1, 11).getValues()[0];
    const eventStart = formatTimeValue(config[3]);
    const eventEnd = formatTimeValue(config[4]);
    const restStart = formatTimeValue(config[9]);
    const restEnd = formatTimeValue(config[10]);

    let totalMinutes = calculateDiffMinutes(eventStart, eventEnd);
    if (restStart && restEnd) {
      totalMinutes -= calculateDiffMinutes(restStart, restEnd);
    }
    
    const finalDuration = Math.max(0, totalMinutes);
    const durStr = Math.floor(finalDuration / 60) + "時" + (finalDuration % 60) + "分";
    
    SS.getSheetByName("Attendance").appendRow([
      new Date(), data.name, data.section, String(data.email).toLowerCase(), 
      data.eventName, data.date, "團練", `${eventStart}~${eventEnd}`, durStr
    ]);
    return { success: true };
  } catch (err) { 
    return { success: false, message: "簽到存儲失敗: " + err.toString() }; 
  }
}

function getAttendanceHistory(data) {
  try {
    const vals = SS.getSheetByName("Attendance").getDataRange().getValues();
    const list = []; 
    const email = String(data.email).toLowerCase();
    
    for (let i = vals.length - 1; i >= 1; i--) {
      if (vals[i][3].toLowerCase() === email) {
        let d = vals[i][5];
        if (d instanceof Date) d = Utilities.formatDate(d, "GMT+8", "yyyy-MM-dd");
        list.push({ date: d, status: vals[i][4], duration: String(vals[i][8]) });
      }
    }
    return { success: true, list: list.slice(0, 50) };
  } catch(e) { return { success: false }; }
}

function getMemberHistory(data) {
  try {
    const vals = SS.getSheetByName("Attendance").getDataRange().getValues();
    const list = []; 
    const targetEmail = String(data.targetEmail).toLowerCase();
    for (let i = vals.length - 1; i >= 1; i--) {
      if (vals[i][3].toLowerCase() === targetEmail) {
        let d = vals[i][5];
        if (d instanceof Date) d = Utilities.formatDate(d, "GMT+8", "yyyy-MM-dd");
        list.push({ date: d, eventName: vals[i][4], duration: String(vals[i][8]) });
      }
    }
    return { success: true, list: list };
  } catch(e) { return { success: false }; }
}

function getAnnouncement() {
  try {
    const data = SS.getSheetByName("Announcements").getRange(2, 1, 1, 2).getValues()[0];
    const content = data[0] || "目前暫無公告內容。";
    const time = data[1] instanceof Date ? Utilities.formatDate(data[1], "GMT+8", "yyyy-MM-dd HH:mm") : "";
    return { success: true, content: content, updateTime: time };
  } catch (e) { return { success: false }; }
}

function saveAnnouncement(data) {
  try {
    SS.getSheetByName("Announcements").getRange(2, 1, 1, 2).setValues([[data.content, new Date()]]);
    return { success: true };
  } catch (e) { return { success: false }; }
}

function saveMember(data) {
  try {
    const sheet = SS.getSheetByName("Members");
    const vals = sheet.getDataRange().getValues();
    const target = String(data.email || "").trim().toLowerCase();
    for (let i = 1; i < vals.length; i++) {
      if (String(vals[i][3]).trim().toLowerCase() === target) {
        if (data.name) sheet.getRange(i + 1, 2).setValue(data.name.trim());
        if (data.instrument) sheet.getRange(i + 1, 7).setValue(data.instrument);
        if (data.password) sheet.getRange(i + 1, 5).setValue(String(data.password).trim());
        return { success: true };
      }
    }
    return { success: false, message: "找不到該成員資料" };
  } catch (err) { return { success: false }; }
}

function getSystemStatus(userData) {
  try {
    const config = SS.getSheetByName("SystemConfig").getRange(2, 1, 1, 12).getValues()[0];
    let ed = config[7]; 
    if (ed instanceof Date) ed = Utilities.formatDate(ed, "GMT+8", "yyyy-MM-dd");
    
    const status = {
      success: true,
      enabled: config[0] === "on",
      eventName: config[1],
      eventDate: ed,
      eventStart: formatTimeValue(config[3]),
      eventEnd: formatTimeValue(config[4]),
      hasCheckedIn: false
    };

    if (status.enabled && userData?.email) {
      const att = SS.getSheetByName("Attendance").getDataRange().getValues();
      const email = userData.email.toLowerCase();
      status.hasCheckedIn = att.some(r => {
        let rd = r[5]; if (rd instanceof Date) rd = Utilities.formatDate(rd, "GMT+8", "yyyy-MM-dd");
        return r[3].toLowerCase() === email && String(rd) === String(ed) && String(r[4]) === String(status.eventName);
      });
    }
    return status;
  } catch(e) { return { success: false }; }
}

function submitSurveyResponse(data) {
  try {
    const activeSurId = SS.getSheetByName("SystemConfig").getRange(2, 12).getValue();
    if (!activeSurId) return { success: false, message: "目前無開放中的調查活動" };

    const sheet = SS.getSheetByName("SurveyResponses");
    const userEmail = data.email.toLowerCase();
    const vals = sheet.getDataRange().getValues();
    
    let rowIdx = -1;
    for (let i = 1; i < vals.length; i++) {
      if (vals[i][1].toLowerCase() === userEmail && String(vals[i][3]) === String(activeSurId)) {
        rowIdx = i + 1; break;
      }
    }

    const rowData = [new Date(), userEmail, "", activeSurId, data.responsesJSON];
    if (rowIdx !== -1) {
      sheet.getRange(rowIdx, 1, 1, 5).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }
    return { success: true };
  } catch (e) { return { success: false, message: e.toString() }; }
}

function getSurveyStatus(data) {
  try {
    const activeId = SS.getSheetByName("SystemConfig").getRange(2, 12).getValue();
    if (!activeId) return { success: true, active: false };

    const template = SS.getSheetByName("SurveyTemplates").getDataRange().getValues().find(r => String(r[0]) === String(activeId));
    if (!template) return { success: true, active: false };

    const resps = SS.getSheetByName("SurveyResponses").getDataRange().getValues();
    const email = data.email.toLowerCase();
    const lastResp = resps.reverse().find(r => r[1].toLowerCase() === email && String(r[3]) === String(activeId));

    return {
      success: true, active: true, title: template[1], description: template[2],
      questions: JSON.parse(template[3] || "[]"), responded: !!lastResp,
      lastResponse: lastResp ? JSON.parse(lastResp[4] || "{}") : {}
    };
  } catch(e) { return { success: false }; }
}

// ==========================================
// E. 輔助與初始化工具 (Helpers)
// ==========================================

function calculateDiffMinutes(start, end) {
  if (!start || !end) return 0;
  try {
    const [sH, sM] = String(start).split(':').map(Number);
    const [eH, eM] = String(end).split(':').map(Number);
    let diff = (eH * 60 + eM) - (sH * 60 + sM);
    return diff < 0 ? diff + 1440 : diff; // 跨午夜處理
  } catch(e) { return 0; }
}

function formatTimeValue(v) { 
  if (v instanceof Date) return Utilities.formatDate(v, "GMT+8", "HH:mm"); 
  if (typeof v === 'string' && v.includes(':')) return v.substring(0, 5); 
  return v ? String(v) : ""; 
}

function checkAndInitSheets() {
  const sheets = ["Members", "Attendance", "Events", "SystemConfig", "Announcements", "SurveyTemplates", "SurveyResponses"];
  sheets.forEach(n => { if(!SS.getSheetByName(n)) SS.insertSheet(n); });
  
  const sysS = SS.getSheetByName("SystemConfig");
  if (sysS.getLastRow() === 0) {
    sysS.appendRow(["狀態", "活動名", "類型", "開始", "結束", "_", "_", "日期", "ID", "休始", "休止", "SurveyID"]);
    sysS.appendRow(["off", "", "", "", "", "", "", "", "", "", "", ""]);
  }
}
