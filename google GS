/**
 * 國樂團簽到系統 - GAS 後端 (預排活動相容版)
 * 修正：缺席次數僅統計「今日（含）以前」已發生的活動
 */

function doPost(e) {
  let result;
  try {
    const requestData = JSON.parse(e.postData.contents);
    const action = requestData.action;
    const data = requestData.data;

    checkAndInitSheets();

    switch (action) {
      case 'loginUser': result = loginUser(data); break;
      case 'registerUser': result = registerUser(data); break;
      case 'submitCheckin': result = submitCheckin(data); break; 
      case 'getAttendanceHistory': result = getAttendanceHistory(data); break;
      case 'getMemberHistory': result = getMemberHistory(data); break; 
      case 'getSystemStatus': result = getSystemStatus(data); break; 
      case 'getEventList': result = getEvents(); break; 
      case 'saveEvent': result = saveEvent(data); break; 
      case 'activateEvent': result = activateEvent(data); break;
      case 'getRealtimeStatus': result = getRealtimeStatus(data); break; 
      case 'saveMember': result = saveMember(data); break; 
      default: result = { success: false, message: "未知指令: " + action };
    }
  } catch (err) {
    result = { success: false, message: "後端錯誤: " + err.toString() };
  }
  return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);
}

/**
 * 監控功能：獲取全員狀態 (優化：僅計算已發生的活動作為缺席基準)
 */
function getRealtimeStatus(userData) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const members = ss.getSheetByName("Members").getDataRange().getValues();
    const attendance = ss.getSheetByName("Attendance").getDataRange().getValues();
    const events = ss.getSheetByName("Events").getDataRange().getValues();
    const sys = getSystemStatus();
    const todayDate = sys.eventDate;
    
    // --- 核心邏輯：計算「截至今日為止」的總活動次數 ---
    const now = new Date();
    const todayStr = Utilities.formatDate(now, "GMT+8", "yyyy-MM-dd");
    let pastEventsCount = 0;
    for (let k = 1; k < events.length; k++) {
      let ed = events[k][3];
      if (ed instanceof Date) ed = Utilities.formatDate(ed, "GMT+8", "yyyy-MM-dd");
      if (String(ed) <= todayStr) {
        pastEventsCount++;
      }
    }

    let filterSection = (userData && userData.role === 'Leader') ? userData.section : null;

    const userStats = {};
    for (let i = 1; i < attendance.length; i++) {
      const email = String(attendance[i][3]).trim().toLowerCase();
      let ad = attendance[i][5];
      if (ad instanceof Date) ad = Utilities.formatDate(ad, "GMT+8", "yyyy-MM-dd");
      
      if (!userStats[email]) userStats[email] = { count: 0, today: false };
      userStats[email].count++;
      if (ad === todayDate) userStats[email].today = true;
    }

    const res = [];
    let p = 0, a = 0;
    for (let j = 1; j < members.length; j++) {
      const mSection = members[j][2];
      const mEmail = String(members[j][3]).trim().toLowerCase();
      
      if (filterSection && mSection !== filterSection) continue;

      const stats = userStats[mEmail] || { count: 0, today: false };
      if (stats.today) p++; else a++;
      
      res.push({ 
        Name: members[j][1], 
        Email: members[j][3], 
        Section: mSection,
        Instrument: members[j][6], 
        Role: members[j][5],
        Modifier: members[j][8] || "無修改紀錄",
        status: stats.today ? "已簽到" : "未簽到",
        // 缺席數 = 歷史總活動數(已發生) - 個人簽到數
        absenceCount: Math.max(0, pastEventsCount - stats.count)
      });
    }

    return { success: true, data: res, stats: { present: p, absent: a } };
  } catch (err) {
    return { success: false, message: "資料庫讀取失敗" };
  }
}

/**
 * 獲取特定成員歷史 (優化：缺席計算同步改進)
 */
function getMemberHistory(data) {
  if (!data.adminEmail) return { success: false, message: "權限不足" };
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const attSheet = ss.getSheetByName("Attendance");
    const eventSheet = ss.getSheetByName("Events");
    const attValues = attSheet.getDataRange().getValues();
    const events = eventSheet.getDataRange().getValues();
    const history = [];
    const targetEmail = String(data.targetEmail).trim().toLowerCase();

    // 歷史紀錄
    for (let i = attValues.length - 1; i >= 1; i--) {
      if (String(attValues[i][3]).trim().toLowerCase() === targetEmail) {
        let d = attValues[i][5];
        history.push({ 
          date: (d instanceof Date) ? Utilities.formatDate(d, "GMT+8", "yyyy-MM-dd") : d, 
          eventName: attValues[i][4], 
          duration: attValues[i][8] || "0時0分" 
        });
      }
    }

    // 計算截至今日已發生次數
    const now = new Date();
    const todayStr = Utilities.formatDate(now, "GMT+8", "yyyy-MM-dd");
    let pastEventsCount = 0;
    for (let k = 1; k < events.length; k++) {
      let ed = events[k][3];
      if (ed instanceof Date) ed = Utilities.formatDate(ed, "GMT+8", "yyyy-MM-dd");
      if (String(ed) <= todayStr) pastEventsCount++;
    }

    return { success: true, list: history, absenceCount: Math.max(0, pastEventsCount - history.length) };
  } catch (err) { return { success: false, message: "讀取失敗" }; }
}

/**
 * 編輯成員資料 (保持姓名反查邏輯)
 */
function saveMember(data) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName("Members");
    const values = sheet.getDataRange().getValues();
    const targetEmail = String(data.email || "").trim().toLowerCase();
    
    if (!targetEmail) return { success: false, message: "Email 資訊缺失" };

    let modifierName = "本人";
    const adminEmail = String(data.adminEmail || "").trim().toLowerCase();

    if (adminEmail && adminEmail !== targetEmail) {
      modifierName = "未知管理員";
      for (let j = 1; j < values.length; j++) {
        if (String(values[j][3]).trim().toLowerCase() === adminEmail) {
          modifierName = values[j][1];
          break;
        }
      }
    }

    for (let i = 1; i < values.length; i++) {
      if (String(values[i][3]).trim().toLowerCase() === targetEmail) {
        if (data.name) sheet.getRange(i + 1, 2).setValue(data.name.trim());
        if (data.instrument) sheet.getRange(i + 1, 7).setValue(data.instrument);
        if (data.role) sheet.getRange(i + 1, 6).setValue(data.role);
        if (data.password) sheet.getRange(i + 1, 5).setValue(String(data.password).trim());

        const timestamp = Utilities.formatDate(new Date(), "GMT+8", "yyyy-MM-dd HH:mm");
        sheet.getRange(i + 1, 9).setValue(modifierName + " (" + timestamp + ")");

        return { success: true, message: "資料已成功更新" };
      }
    }
    return { success: false, message: "找不到帳號" };
  } catch (err) {
    return { success: false, message: "更新失敗" };
  }
}

// --- 系統基礎功能 (其餘部分保持不變) ---

function getSystemStatus(userData) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const configSheet = ss.getSheetByName("SystemConfig");
    const configRows = configSheet.getDataRange().getValues();
    if (configRows.length < 2) return { success: true, enabled: false };
    const configValues = configRows[1]; 
    let eventDate = configValues[7];
    if (eventDate instanceof Date) eventDate = Utilities.formatDate(eventDate, "GMT+8", "yyyy-MM-dd");
    const status = { success: true, enabled: configValues[0] === "on", eventName: configValues[1], eventType: configValues[2], eventStart: formatTimeValue(configValues[3]), eventEnd: formatTimeValue(configValues[4]), eventDate: eventDate, hasCheckedIn: false };
    if (status.enabled && userData && userData.email) {
      const attValues = ss.getSheetByName("Attendance").getDataRange().getValues();
      const userEmail = String(userData.email).trim().toLowerCase();
      for (let i = 1; i < attValues.length; i++) {
        let rowDate = attValues[i][5];
        if (rowDate instanceof Date) rowDate = Utilities.formatDate(rowDate, "GMT+8", "yyyy-MM-dd");
        if (String(attValues[i][3]).trim().toLowerCase() === userEmail && rowDate === eventDate && String(attValues[i][4]) === status.eventName) { status.hasCheckedIn = true; break; }
      }
    }
    return status;
  } catch (err) { return { success: false, message: "系統狀態同步失敗" }; }
}

function submitCheckin(data) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName("Attendance");
    let finalDuration = "0時0分";
    if (data.eventTimeRange && data.eventTimeRange.includes('~')) {
      const times = data.eventTimeRange.split('~').map(t => t.trim());
      if (times.length === 2) {
        const [startH, startM] = times[0].split(':').map(Number);
        const [endH, endM] = times[1].split(':').map(Number);
        let diff = (endH * 60 + endM) - (startH * 60 + startM);
        if (diff < 0) diff += 1440; 
        finalDuration = `${Math.floor(diff / 60)}時${diff % 60}分`;
      }
    }
    sheet.appendRow([new Date(), data.name, data.section, String(data.email).trim().toLowerCase(), data.eventName, data.date, data.type, data.eventTimeRange, finalDuration]);
    return { success: true };
  } catch (err) { return { success: false, message: "簽到失敗" }; }
}

function formatTimeValue(val) {
  if (val instanceof Date) return Utilities.formatDate(val, "GMT+8", "HH:mm");
  if (typeof val === 'string' && val.includes(':')) return val.substring(0, 5);
  return val ? String(val) : "";
}

function registerUser(data) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Members");
  const values = sheet.getDataRange().getValues();
  const email = String(data.email).trim().toLowerCase();
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][3]).trim().toLowerCase() === email) return { success: false, message: "帳號已存在" };
  }
  sheet.appendRow(["MEM-" + new Date().getTime(), data.name.trim(), data.section, email, String(data.password).trim(), "Member", data.instrument, new Date(), "系統建立"]);
  return { success: true };
}

function loginUser(data) {
  const values = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Members").getDataRange().getValues();
  const inputEmail = String(data.email).trim().toLowerCase();
  const inputPwd = String(data.password).trim();
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][3]).trim().toLowerCase() === inputEmail && String(values[i][4]) === inputPwd) {
      return { success: true, user: { Name: values[i][1], Section: values[i][2], Email: values[i][3], Role: values[i][5], Instrument: values[i][6] } };
    }
  }
  return { success: false, message: "帳密錯誤" };
}

function getEvents() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Events");
  const values = sheet.getDataRange().getValues();
  const events = [];
  for (let i = 1; i < values.length; i++) {
    let d = values[i][3];
    events.push({ ID: values[i][0], Name: values[i][1], Type: values[i][2], Date: (d instanceof Date) ? Utilities.formatDate(d, "GMT+8", "yyyy-MM-dd") : String(d), StartTime: formatTimeValue(values[i][4]), EndTime: formatTimeValue(values[i][5]), Duration: values[i][6] });
  }
  return { success: true, data: events.reverse() };
}

function saveEvent(data) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Events");
  let dur = "0時0分";
  if (data.startTime && data.endTime) {
    const [sH, sM] = data.startTime.split(':').map(Number);
    const [eH, eM] = data.endTime.split(':').map(Number);
    let diff = (eH * 60 + eM) - (sH * 60 + sM);
    if (diff < 0) diff += 1440; 
    dur = `${Math.floor(diff / 60)}時${diff % 60}分`;
  }
  const rowData = [data.id || "EVT-" + new Date().getTime(), data.name, data.type || "團練", data.date, data.startTime, data.endTime, dur, new Date()];
  if (data.id) {
    const values = sheet.getDataRange().getValues();
    for (let i = 1; i < values.length; i++) { if (String(values[i][0]) === String(data.id)) { sheet.getRange(i + 1, 1, 1, rowData.length).setValues([rowData]); break; } }
  } else { sheet.appendRow(rowData); }
  return { success: true };
}

function activateEvent(data) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const configSheet = ss.getSheetByName("SystemConfig");
  configSheet.getRange(2, 1, 1, 9).setValues([[ "on", data.name, data.type, data.start, data.end, "", "", data.date, data.id || "" ]]);
  return { success: true };
}

function getAttendanceHistory(data) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Attendance");
  const values = sheet.getDataRange().getValues();
  const history = [];
  const email = String(data.email).trim().toLowerCase();
  for (let i = values.length - 1; i >= 1; i--) {
    if (String(values[i][3]).trim().toLowerCase() === email) {
      let d = values[i][5];
      history.push({ date: (d instanceof Date) ? Utilities.formatDate(d, "GMT+8", "yyyy-MM-dd") : d, status: values[i][4], duration: values[i][8] || "0時0分" });
    }
  }
  return { success: true, list: history.slice(0, 50) };
}

function checkAndInitSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ["Members", "Attendance", "Events", "SystemConfig"];
  sheets.forEach(name => { if(!ss.getSheetByName(name)) ss.insertSheet(name); });
}
